# Used by systemd EnvironmentFile; shell: set -a; . ./.env; set +a
BOT_TOKEN=REPLACE_WITH_NEW_BOTFATHER_TOKEN
ADMIN_ID=123456789
# Optional separate bot for critical alerts. Admin must /start that bot too.
ALERT_BOT_TOKEN=
# Leave empty for direct access. PROXY remains a legacy alias for TELEGRAM_PROXY.
TELEGRAM_PROXY=
SOURCE_PROXY=
# Independent route for alerts (empty = direct).
ALERT_PROXY=
database=flats_bot
user=flatsdbuser
password=REPLACE_ME
host=127.0.0.1
port=5432
DATA_DIR=/var/lib/flats-bot
LOG_DIR=/var/log/flats-bot
MAX_PAGES=10
